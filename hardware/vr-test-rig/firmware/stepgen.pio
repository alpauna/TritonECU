;
; stepgen.pio — one step pulse per FIFO word, 50 % duty
;
; Each 32-bit word written to the TX FIFO is a HALF-period, in PIO cycles.
; The state machine drives the pin high for that long, then low for the same,
; so the mark/space is always 50 %. That matters: the DM542 wants a pulse of
; at least 2.5 us, and a 50 % duty satisfies it automatically for any period
; down to 5 us (200 kHz), which is the driver's own input ceiling.
;
; Cycle accounting, for the host to convert a period into a FIFO word:
;       high = x + 2 cycles      (mov, then jmp x-- running x+1 times)
;       low  = x + 3 cycles      (mov, jmp x+1 times, then the next pull)
;       period = 2x + 5
;   so  x = (period_cycles - 5) / 2
;
; Polarity: the 2N7002 driver board inverts. A HIGH here turns the FET on,
; which pulls the DM542's PUL- low and lights the optocoupler. So side 1 is
; the ACTIVE pulse, and the pin idles low — which is also the safe state the
; gate pulldown holds during reset.
;
.program stepgen
.side_set 1

.wrap_target
    pull block          side 0      ; wait for the next half-period, pin idle
    mov x, osr          side 1      ; pulse begins
hi:
    jmp x--, hi         side 1
    mov x, osr          side 0      ; pulse ends (OSR still holds the count)
lo:
    jmp x--, lo         side 0
.wrap

; The c-sdk init block lives in stepgen.pio.h instead, so that one header
; serves both builds — CMake regenerates it into the build tree via
; pico_generate_pio_header(), PlatformIO uses the committed copy.

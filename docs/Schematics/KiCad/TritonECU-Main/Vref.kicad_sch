	(text "VREF: NCV8772C 5.00 V on VPROT (the LTC4364 output, not the 5 V buck-boost), EN under MCU control." (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "60245b0b-20ab-4f2e-80b6-0c741be65671"))
	(text "TPS2H160B-Q1: RCL 8.06k = 248 mA per feed; RCS 2.2k (2.5 V linear ceiling at VS = 5 V); THER high = latch." (exclude_from_sim no) (at 20.00 24.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "297cd6ef-e1e2-4f72-a8b7-6a1041ebdc9d"))
	(text "LM74700-Q1 + DMN6040 (VGS +-20 V) blocks a short to battery; SMAJ24CA stands off 24 V, transients only. No PPTC." (exclude_from_sim no) (at 20.00 28.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "295f5ee7-e781-48c0-9ad8-52b778eb8541"))
	(text "Firmware sheds a faulted channel (t_CL deg 80-180 us), retries seconds apart. Hold IN1/IN2/SEL low while EN is low." (exclude_from_sim no) (at 20.00 32.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "043d3232-378e-459c-94eb-eebc4f9c9430"))

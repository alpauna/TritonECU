	(text "microSD, SDMMC2 1-bit. Card power through TPS22917 on SD_PWR_EN (100k down): 3.3 V is always on and an idle" (exclude_from_sim no) (at 170.00 165.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "35d3754c-3fe8-457e-8e96-bd4f309b0d45"))

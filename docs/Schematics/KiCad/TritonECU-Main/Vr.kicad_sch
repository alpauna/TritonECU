	(text "VR inputs: 3 x MAX9926, Mode A2 (INT_THRS = ZERO_EN = GND, EXT open). 2 x 5k 0805 per leg = 300 V headroom" (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "ff5ed2f8-04ca-4739-a6a5-b657227a34e2"))
	(text "(V1 had one; add-on per vr-conditioning.md). 470 pF C0G 200 V across the inputs: 2x10k -> 17 kHz, 0.34 deg at 6000 rpm." (exclude_from_sim no) (at 20.00 24.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "14b4e329-f1e8-4d4e-a130-ccf6b20f0e50"))
	(text "BIAS: 100 nF to GND (review-vr-v1 #3). VCC: 10 nF closest + 100 nF + 1 uF. COUT open drain, 10k to 3.3 V." (exclude_from_sim no) (at 20.00 28.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "edf3a4f6-a0f5-4914-afbb-20c0823d5a01"))
	(text "Single-ended sensors (CMP, OSS, TSS, transfer case) return their - leg on SIGRTN, pin 91." (exclude_from_sim no) (at 20.00 32.00 0) (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "0f1a2684-d1f5-4455-b430-865d28bb97d4"))

         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCV8405 - Self-Protected Low Side Driver with Temperature and Current Limit</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>s2190c</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCV8405A/B is a three terminal protected Lowâˆ’Side Smart&#xD;&#xA;Discrete device. The protection features include overcurrent,&#xD;&#xA;overtemperature, ESD and integrated Drainâˆ’toâˆ’Gate clamping for&#xD;&#xA;overvoltage protection. This device is suitable for harsh automotive&#xD;&#xA;environments.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 18.0 (Windows)</pdf:Producer>
         <xmpMM:DocumentID>uuid:ec373767-7948-44fa-ac5a-7f1de5f90f4f</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:b538e662-8c2f-4199-906d-ca86c557eed3</xmpMM:InstanceID>
         <illustrator:StartupProfile>Print</illustrator:StartupProfile>
